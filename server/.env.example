# 服务端口
PORT=3001

# OpenRouter API Key（服务器部署必填）
# 本地开发可不填：会自动向上级目录查找 apikey.txt 并提取 sk-or-v1- 开头的 Key
OPENROUTER_API_KEY=

# 或指定 Key 文件路径（优先级低于 OPENROUTER_API_KEY）
# APIKEY_FILE=/path/to/apikey.txt

# AI 模型（OpenRouter 模型 ID）
AI_MODEL=deepseek/deepseek-v3.2

# 数据目录（SQLite 数据库存放位置，默认 server/data）
# DATA_DIR=/var/lib/hot-monitor

# 定时抓取 cron 表达式（默认每 30 分钟）
# CRON_EXPRESSION=*/30 * * * *
